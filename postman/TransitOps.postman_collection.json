{
  "info": {
    "name": "TransitOps API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" }
  ],
  "item": [
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"manager@transitops.local\",\n  \"password\": \"TransitOps@123\"\n}" },
        "url": "{{baseUrl}}/auth/login"
      },
      "event": [{
        "listen": "test",
        "script": { "exec": ["const json = pm.response.json();", "pm.collectionVariables.set('accessToken', json.accessToken);", "pm.collectionVariables.set('refreshToken', json.refreshToken);"] }
      }]
    },
    { "name": "Dashboard", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/dashboard" } },
    { "name": "Vehicles - List", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/vehicles?page=1&pageSize=10&search=" } },
    {
      "name": "Vehicles - Create",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"registrationNumber\": \"TO-DEMO-9001\",\n  \"vehicleName\": \"Demo Hauler\",\n  \"model\": \"Ashok Leyland AVTR\",\n  \"type\": \"Truck\",\n  \"region\": \"North\",\n  \"maximumCapacity\": 12000,\n  \"odometer\": 9000,\n  \"acquisitionCost\": 68000,\n  \"status\": \"AVAILABLE\",\n  \"maintenanceDueAtKm\": 15000\n}" },
        "url": "{{baseUrl}}/vehicles"
      }
    },
    { "name": "Drivers - List", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/drivers" } },
    { "name": "Trips - List", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/trips" } },
    { "name": "Maintenance - List", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/maintenance" } },
    { "name": "Fuel Logs - List", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/fuel-logs" } },
    { "name": "Expenses - List", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/expenses" } },
    { "name": "Reports - Fuel Efficiency CSV", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/reports/fuel-efficiency?format=csv" } }
  ]
}
